fn del(list1,index) {
    set l1 = list1[0:index];
    index = index + 1;
    set l2 = list1[index:];
    set l1 = addlist(l1,l2);
    return l1;
}

fn setlist(listc,index,index2) {
    set l1 = listc[0:index];
    index = index + 1;
    set l2 = listc[index:];
    set l1 = addlist(l1,index2);
    set l1 = addlist(l1,l2);
    return l1;
}

