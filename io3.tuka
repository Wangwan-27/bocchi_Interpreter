file.write("test.txt", "");
set lin = file.read("test.txt");
set x = lin.split("\n");
set i = 0;
set a = 0;

set addlist = lambda(a,b) {
    file.write("test.txt", a.string +"\n"+ b.string);
    lin = file.read("test.txt");
    x = lin.split("\n");
    file.delete("test.txt");

    loop (i<x.len+1) {
        i = i + 1;
        set a = x.string.replace("]","");
        set a = a.string.replace("[","");
        set a = a.string.replace("   ","");
        set a = a.string.split(" ");
    }
    
    return a;
};

