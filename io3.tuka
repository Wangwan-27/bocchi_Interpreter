// 随机选列表一个元素
fn choice(list1) {
    if (list1.len == 0) {
        return void;
    }
    return list1[rand(0, list1.len - 1)];
}

//puts choice([1,2,3,4,5]);


//排序 第一参数为列表，第二参数为是否降序，默认升序
fn sort(arr, reverse = false) {
    set n = arr.len;
    for..in i n {
        set j = i + 1;
        loop (j < n) {
            set need = false;
            if (reverse) {
                if (arr[j] > arr[i]) { need = true; }
            } else {
                if (arr[j] < arr[i]) { need = true; }
            }
            if (need) {
                set t = arr[i];
                arr[i] = arr[j];
                arr[j] = t;
            }
            j = j + 1;
        }
    }
    return arr;
}

set a = [3, 1, 4, 1, 5, 9, 2, 6];
//puts sort(a);              // 输出：[1, 1, 2, 3, 4, 5, 6, 9]
//puts sort(a, true);        // 降序：[9, 6, 5, 4, 3, 2, 1, 1]

//列表反转
fn reverse2(arr) {
    set n = arr.len;
    for..in i (n / 2).int {
        set t = arr[i];
        arr[i] = arr[n - 1 - i];
        arr[n - 1 - i] = t;
    }
    return arr;
}
//puts reverse2(a);
