fn add1(a, b) {
    return a + b;
}

fn multiply(a, b) {
    return a * b;
}

// 定义测试
test "测试加法函数" {
    assert(add1(2, 3) == 5, "2 + 3 应该等于 5");
    assert(add1(-1, 1) == 0, "-1 + 1 应该等于 0");
    assert(add1(0, 0) == 0, "0 + 0 应该等于 0");
}

// 手动运行测试
runTests;//不写的话就合并测试

// 继续主程序逻辑
puts "主程序继续执行...";

test "测试乘法函数" {
    assert(multiply(2, 3) == 6, "2 * 3 应该等于 6");
    assert(multiply(-1, 5) == -5, "-1 * 5 应该等于 -5");
    assert(multiply(0, 10) == 0, "0 * 10 应该等于 0");
}

