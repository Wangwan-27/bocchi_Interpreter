// 示例：并发计算斐波那契数列并使用 ok() 共享结果

fn fib(n) {
    if (n <= 1) {
        return n;
    }
    set x = fib(n-1) + fib(n-2);
    return x;
}

static int result1 = 1;

// 使用 go{} 和 ok() 并发计算多个斐波那契数
go {
    result1 = fib(35);
    ok(global_result1) = result1;  // 使用 ok() 将结果设置到全局环境
    puts "goroutine 1 完成: fib(35) = ", result1;
}

time.sleep(1);
puts "fib(35) = ", global_result1;

result1 = 1;
go {
    for..in i 1000{
        result1 = result1 + 1;
    }
    puts result1;
    ok(aa2) = result1;
}
wait_all;
puts "jieguo:" , aa2 , result1;



set result12 = 0;
go {
    for..in i 1000{
        result12 = result12 + 1;
    }
    ok(result12) = result12;
}
wait_all;
puts result12;


set ccc = [1,2,3,4,56];
for i in ccc {
    putsf i;
}


