//2029.6

obj aa{
	let name = "a";
    let name2 = "a2";
}
set x = aa$name;
puts x;//输出a
puts aa$name2;

obj ab{
	let name = "bbb";
    //let x = 0;
    fn abs(a,b) {
        return a + b;
    }
    fn nn(){
        return this$name;
    }
}
puts ab$abs(35,1), ab$name;
puts ab$nn();


obj Calculator {
    fn fib_rec1(n) {
        if (n <= 1) {
            return n;
        }
        set x = this$fib_rec1(n-1) + this$fib_rec1(n-2);
        return x;
    }
}
//puts Calculator$fib_rec1(30);
set xc = Calculator;
puts xc$fib_rec1(2);


obj Animal {
    let name = "动物";
    let age = 0;
    
    fn speak() {
        puts this$name + " 发出声音";
    }
    
    fn getAge() {
        return this$age;
    }
}

// 定义子类，继承父类
obj Dog ? Animal {
    let breed = "未知品种";
    let age = 1;
    
    // 覆盖父类方法
    fn speak() {
        puts "汪汪！我是" + this$name + "，品种是" + this$breed;
    }
    
    fn wagTail() {
        puts this$name + " 摇尾巴";
    }
}

// 创建对象
set myDog = Dog;
puts myDog$name;  // 输出：动物（继承自父类）
puts myDog$breed; // 输出：未知品种

//只继承父类的fn方法，不继承let变量
puts myDog$getAge(); // 输出：0（继承自父类）

