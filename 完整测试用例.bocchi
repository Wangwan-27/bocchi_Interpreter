//2028.1
// 默认参数示例
fn greet(name, greeting = "Hello") {
    return greeting + ", " + name + "!";
}

puts greet("Alice");           // 输出: Hello, Alice!
puts greet("Bob"+"Hi");       // 输出: Hi, Bob!

fn sum(...numbers) {
    set total = 0;
    for n in numbers {
        total = total + n;
    }
    return total;
}

puts sum(1, 2, 3);        // 输出: 6
puts sum(1, 2, 3, 4, 5);  // 输出: 15

fn calculate(operation, ...values) {
    if (operation == "add") {
        set result = 0;
        for v in values {
            result = result + v;
        }
        return result;
    } else if (operation == "multiply") {
        set result = 1;
        for v in values {
            result = result * v;
        }
        return result;
    }
}

puts calculate("add", 1, 2, 3);        // 输出: 6
puts calculate("multiply", 2, 3, 4);   // 输出: 24
puts calculate(2, 3, 4);               // 使用默认operation "add", 输出: 9



