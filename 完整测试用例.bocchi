// 测试取整功能
clear;
title("Hi");

set a = 3.14159265;
puts "原始值:", a;
puts "向下取整:", floor(a);    // 输出 3
puts "向上取整:", ceil(a);     // 输出 4  
puts "四舍五入:", round(a);    // 输出 3

set b = 2.71828;
puts "b 原始值:", b;
puts "b 向下取整:", floor(b);  // 输出 2
puts "b 向上取整:", ceil(b);   // 输出 3
puts "b 四舍五入:", round(b);  // 输出 3

set c = 5.6;
puts "c 四舍五入:", round(c);  // 输出 6

// 也可以在表达式中使用
set result = round(3.14159 * 10) / 10;
puts "保留一位小数:", result;  // 输出 3.1

// 不换行输出
putsf "Loading: ";
putsf "50%";

// 重写输出（用于进度条等）
putsr "Progress: [===      ] 30%";
time.sleep(0.5);
putsr "Progress: [======   ] 60%";
time.sleep(0.5);
putsr "Progress: [=========] 100%";
puts ""; // 最后换行

// 支持嵌入变量
set name = "Bocchi";
putsf "Hello, ";
putsf name;
puts "!"; // 最后换行

type bool c = a != b;
puts c;

// 使用快速列表生成器语法

putsf range(5);          // [0,1,2,3,4]
putsf range(1, 6);       // [1,2,3,4,5]
putsf range(0, 10, 2);   // [0,2,4,6,8]
putsf repeat("hi", 3); // ["hi", "hi", "hi"]

// 传统列表字面量（修复后的）
putsf [1, 2, 3];          // 正常
putsf [];                 // 空列表
putsf [1, 2, 3,];         // 支持尾随逗号
puts;
