memory.write("aaa", 1);
memory.add("aaa", 2);
//puts memory.size(), memory.read("aaa");

memory.write("bbb", 1);
puts memory.size(), memory.read("aaa")+memory.read("bbb");

memory.write("greeting", "Hello");
memory.append("greeting", ", Bocchi");      // 字符串拼接
puts memory.getString("greeting");          // → Hello, Bocchi

memory.write("greeting", "100");              // 覆盖为数字
puts memory.getString("greeting", "N/A");   // → 100（自动转字符串）第 2 个参数 "N/A"：可选的默认值。只在 key 不存在时才会用到它。
//如果值不是字符串（比如数字、列表），用 fmt.Sprint 转成字符串返回。
//没查到 → 返回第二个参数 "N/A"；如果连第二个参数都没给，就返回空字符串 ""

memory.writeString("log", "Start");
memory.append("log", " - OK");              // 强制字符串追加
puts memory.getString("log");               // → Start - OK

memory.write("arr", [1, 2]);
memory.append("arr", 3);                    // 列表追加
memory.append("arr", [4, 5]);               // 列表合并
puts memory.getString("arr");               // → [1 2 3 4 5]


memory.delete("greeting");     // 删掉一个键
set v = memory.read("greeting");
memory.clear();